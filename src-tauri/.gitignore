# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Sidecar binaries (large, platform-specific — fetched/copied at build time)
/binaries/

# Mobile icon assets (desktop-only app, generated incidentally by `tauri icon`)
/icons/ios/
/icons/android/
