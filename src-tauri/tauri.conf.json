{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JuryAIssist",
  "version": "0.1.3",
  "identifier": "com.fouzia.juryaissist",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JuryAIssist",
        "width": 720,
        "height": 640,
        "minWidth": 560,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyNUM4QjcwMEVEQzRDNDMKUldSRFROd09jSXRjUWk0dWNXenZHNDlUTE1xODN5TUo3TkVoS1VQYitNTmpBOFJRVnpLR05ETnMK",
      "endpoints": [
        "https://github.com/Ribraba/JuryAIssist_Reloaded/releases/latest/download/latest.json"
      ]
    }
  }
}
